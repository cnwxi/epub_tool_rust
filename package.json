{
  "name": "epub-tool-newui",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "protocol:generate": "npx --yes @bufbuild/buf@1.72.0 generate && node scripts/normalize_protocol_generated.mjs",
    "protocol:check": "npm run protocol:generate && git diff --exit-code -- frontend/src/generated",
    "build:verify-ocr-model": "cargo run --locked --manifest-path xtask/Cargo.toml -- verify-ocr-model",
    "dev:bundle-assets": "npm run build:verify-ocr-model",
    "dev:frontend": "npm --prefix frontend run dev -- --host",
    "dev:desktop": "npm run dev:bundle-assets && npm run dev:frontend",
    "dev:mobile": "npm --prefix frontend run dev -- --mode mobile --host",
    "build:mobile-assets": "npm --prefix frontend run build:mobile",
    "build:bundle-assets": "npm run build && npm run build:verify-ocr-model",
    "tauri": "tauri",
    "tauri:dev": "cargo run --locked --manifest-path xtask/Cargo.toml -- desktop-dev",
    "tauri:build": "cargo run --locked --manifest-path xtask/Cargo.toml -- desktop-build",
    "tauri:android:init": "npm run tauri -- android init",
    "tauri:android:dev": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-dev android",
    "tauri:android:build": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-build android",
    "tauri:android:check": "npm run tauri -- android build --debug"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5"
  }
}
